        C2 -.- C1
        C3 -.- C1
    end
    subgraph AFT["Service parts"]
        direction TB
        A1["Parts for resale,<br/>c.80,000 SKUs"]
        A2["Control: ToolsGroup<br/>daily safety stock,<br/>97.1 per cent FTA"]
        A3["Works heritage parts<br/>remanufactured"]
        A2 -.- A1
        A1 --> A3
    end
    DEP["Specials deposits<br/>pre-fund build: £336m<br/>2022, £272m 2023"]
