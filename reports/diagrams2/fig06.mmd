    RAW --> WIPG
    WIPG --> FGD
    FGD -->|"Wholesale"| CHN
    RAW --> AFT
    DEP -.-> WIPG
    FIN -.- RAW
    classDef bottleneck fill:#f8d7da,stroke:#b03a2e,stroke-width:3px,color:#000
