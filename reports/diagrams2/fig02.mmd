flowchart LR
    subgraph ORD["0 Order and inbound"]
        direction TB
        O1["Order frozen, VIN and<br/>build slot set<br/>(inferred)"]
        O2["DHL: inbound, store,<br/>sequence and kit parts"]
        O3["Aluminium structures<br/>and castings received"]
        O1 --> O2 --> O3
    end
    subgraph BODY["1 Body shop"]
        direction TB
        B1["Robot applies<br/>bonding adhesive"]
        B2["Panels hand-placed<br/>in jig and riveted"]
        B3["Oven cure of bonded<br/>structure: sets takt"]
        B4["Closures hand-fitted:<br/>doors, wings, bonnet"]
        B5{"Body check<br/>passed?<br/>(inferred)"}
        B6["Body rectification<br/>(inferred)"]
        B1 --> B2 --> B3 --> B4 --> B5
        B5 -->|"No"| B6
        B6 --> B5
    end
    subgraph PAINT["2 Paint shop"]
        direction TB
        P1["Clean and prepare<br/>body shell"]
        P2["Two primer coats,<br/>each hand-flatted"]
        P3{"Standard or<br/>Q special colour?"}
        P4["Robot colour coat<br/>(forum evidence)"]
        P5["Hand-sprayed colour<br/>(forum evidence)"]
        P6["Clear coat and cure"]
        P7["Hand flat and polish:<br/>largest labour block,<br/>25 to 50 hours"]
        P8{"Paint inspection<br/>passed?"}
        P9["Re-flat, re-polish<br/>or respray (inferred)"]
        P1 --> P2 --> P3
        P3 -->|"Standard"| P4
        P3 -->|"Special"| P5
        P4 --> P6
        P5 --> P6
        P6 --> P7 --> P8
        P8 -->|"No"| P9
        P9 --> P8
    end
    NEXT(["To part b: trim<br/>and final assembly"])
    ORD --> BODY
    BODY -->|"Passed"| PAINT
    PAINT -->|"Passed"| NEXT
    classDef bottleneck fill:#f8d7da,stroke:#b03a2e,stroke-width:3px,color:#000
    classDef inferred fill:#fff8e1,stroke:#8d6e63,stroke-dasharray:5 5,color:#000
    class B3,P7 bottleneck
    class O1,B5,B6,P9 inferred
